{
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4.1",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "beberlei/doctrineextensions": "^1.5",
        "campaignmonitor/createsend-php": "^7.0",
        "cmen/google-charts-bundle": "^7.1",
        "composer/package-versions-deprecated": "^1.11",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.5",
        "endroid/qr-code": "^6.1",
        "erusev/parsedown": "^1.7",
        "friendsofsymfony/jsrouting-bundle": "^3.6",
        "gedmo/doctrine-extensions": "^3.22",
        "geocodio/geocodio-library-php": "^1.4",
        "league/csv": "^9.2",
        "sabre/vobject": "^4.4",
        "scheb/2fa-bundle": "^8.6",
        "scheb/2fa-totp": "^8.6",
        "scheb/2fa-trusted-device": "^8.6",
        "stof/doctrine-extensions-bundle": "^1.15",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "^8.1",
        "symfony/cache": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/expression-language": "^8.1",
        "symfony/flex": "^2.3",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/intl": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/monolog-bundle": "^4.1",
        "symfony/notifier": "^8.1",
        "symfony/panther": "^2.4",
        "symfony/runtime": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/twilio-notifier": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/webpack-encore-bundle": "^2.0",
        "symfony/yaml": "^8.1",
        "symfonycasts/reset-password-bundle": "^1.24",
        "twig/cssinliner-extra": "^3.6",
        "twig/extra-bundle": "^3.6",
        "twig/inky-extra": "^3.6",
        "twig/intl-extra": "^3.6",
        "twig/markdown-extra": "^3.6",
        "twig/string-extra": "^3.6",
        "twilio/sdk": "^6.21"
    },
    "config": {
        "platform": {
            "php": "8.4.23"
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^8.1"
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.7",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.0",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/maker-bundle": "^1.68",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/stopwatch": "^8.1",
        "symfony/var-dumper": "^8.1",
        "symfony/web-profiler-bundle": "^8.1"
    }
}
